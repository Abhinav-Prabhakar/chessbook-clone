{
  "name": "chessbook",
  "version": "1.0.0",
  "description": "Chessbook — full-stack opening repertoire trainer (React + Express + SQLite)",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,green \"npm:dev:server\" \"npm:dev:app\"",
    "dev:server": "node server/index.js",
    "dev:app": "vite --config app/vite.config.ts",
    "build": "npm run build:app",
    "build:app": "vite build --config app/vite.config.ts",
    "start": "node server/index.js",
    "preview": "vite preview --config app/vite.config.ts",
    "db:reset": "node server/reset.js",
    "serve:static": "python3 -m http.server 4173",
    "test": "node --test tests",
    "test:e2e": "npm run build && node audit/e2e/main-flow.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "stockfish": "^19.0.1"
  },
  "private": true
}
