{
  "name": "chessbook",
  "version": "1.0.0",
  "description": "Chessbook \u2014 build, learn and practice your chess opening repertoire (React + Express + SQLite)",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,green \"npm:dev:server\" \"npm:dev:app\"",
    "dev:server": "node server/index.js",
    "dev:app": "vite --config app/vite.config.ts",
    "build": "npm run build:app",
    "build:app": "vite build --config app/vite.config.ts",
    "start": "node server/index.js",
    "preview": "vite preview --config app/vite.config.ts",
    "db:reset": "node server/reset.js",
    "serve:static": "python3 -m http.server 4173",
    "test": "node --test --test-concurrency=1 tests/",
    "test:e2e": "node tests/e2e/practice-flow.mjs",
    "data:lichess": "node server/tools/fetch-lichess-games.mjs && node --max-old-space-size=5000 server/tools/build-explorer.mjs --dataset=lichess --in=$HOME/.cache/chessbook-data/lichess-2026-09.txt",
    "data:masters": "node server/tools/fetch-master-games.mjs && node --max-old-space-size=5000 server/tools/build-explorer.mjs --dataset=masters --in=$HOME/.cache/chessbook-data/masters.txt --min=5 --depth=24",
    "data:puzzles": "node server/tools/fetch-puzzles.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "stockfish": "^19.0.1"
  },
  "private": true
}